# Elija su sistema operativo (descomente UNA pareja de líneas). Así "docker compose" y los
# scripts de scripts/ usan automáticamente el archivo de su SO. En Linux no hace falta nada.
# --- macOS ---
#COMPOSE_FILE=docker-compose.yml:docker-compose.mac.yml
#COMPOSE_PATH_SEPARATOR=:
# --- Windows (WSL2) ---
#COMPOSE_FILE=docker-compose.yml:docker-compose.windows.yml
#COMPOSE_PATH_SEPARATOR=:

# Opcional: copia este archivo a .env si necesitas cambiar algo (docker compose usa estos valores por defecto).
# En Linux, si tu usuario no es 1000, pon aquí la salida de `id -u` y `id -g`.
# Escritorio virtual de Cooja (noVNC en http://localhost:6080)
VNC_GEOMETRY=1600x900
VNC_PASSWORD=
COOJA_AUTOSTART=0
LOCAL_UID=1000
LOCAL_GID=1000
# Rama/etiqueta de Contiki-NG que clona el servicio contiki-init (solo la 1.ª vez)
CNG_TAG=develop
# Puerto TCP del puente serie del coordinador Zigbee (Mac/Windows, práctica 8 ruta C)
ZIGBEE_TCP_PORT=6638
